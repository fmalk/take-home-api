        ],
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/user",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "user"]
        }
      },
      "response": []
    },
    {
      "name": "Search (OneWay)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "search"],
          "query": [
            {
              "key": "from",
              "value": ""
            },
            {
              "key": "to",
              "value": ""
            },
            {
              "key": "departureDate",
              "value": "",
              "description": "YYYY-MM-DD"
            }
          ]
        },
        "description": "If departureDate is within 15 days, each returned flight has one of its seat classes randomly withheld (never its only class) — a v4-only last-minute-booking quirk."
      },
      "response": []
    },
    {
      "name": "Search (RoundTrip)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/search",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "search"],
          "query": [
            {
              "key": "from",
              "value": ""
            },
            {
              "key": "to",
              "value": ""
            },
            {
              "key": "departureDate",
              "value": "",
              "description": "YYYY-MM-DD"
            },
            {
              "key": "mode",
              "value": "RoundTrip"
            },
            {
              "key": "returnDate",
              "value": "",
              "description": "YYYY-MM-DD"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Pages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/search/pages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "search", "pages"],
          "query": [
            {
              "key": "id",
              "value": "",
              "description": "Search ID returned by GET /search"
            },
            {
              "key": "outboundPage",
              "value": "2",
              "description": "Page number (1-based) of outbound routes to fetch"
            },
            {
              "key": "inboundPage",
              "value": "",
              "description": "Page number (1-based) of inbound routes to fetch"
            }
          ]
        },
        "description": "Fetch a specific page (15 routes per page) of a prior search's outbound and/or inbound routes."
      },
      "response": []
    },
    {
      "name": "Purchase (OneWay)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"OneWay\",\n  \"outboundId\": \"{{outboundRouteId}}\",\n  \"currency\": \"USD\",\n  \"price\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/purchase",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "purchase"]
        },
        "description": "outboundRouteId and price come from a prior Search response's outbound route; route IDs expire ~5 minutes after the search."
      },
      "response": []
    },
    {
      "name": "Purchase (RoundTrip)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"RoundTrip\",\n  \"outboundId\": \"{{outboundRouteId}}\",\n  \"inboundId\": \"{{inboundRouteId}}\",\n  \"currency\": \"USD\",\n  \"price\": 0\n}"
        },
        "url": {
          "raw": "http://localhost:{{port}}/api/travel/v4/purchase",
          "protocol": "http",
          "host": ["localhost"],
          "port": "{{port}}",
          "path": ["api", "travel", "v4", "purchase"]
        },
        "description": "price must equal the sum of the outbound and inbound routes for the chosen currency."
      },
      "response": []
    }
